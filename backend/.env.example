# Use PostgreSQL in production. SQLite is only the zero-configuration local default.
DATABASE_URL=postgresql+psycopg2://retailiq:your_db_password_here@localhost:5432/retailiq
SECRET_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173
# Set true behind HTTPS in production.
COOKIE_SECURE=false
# Demo account seeding is disabled in production (disabled by default)
SEED_DEMO=false
# Optional: set a custom strong password if demo seeding is explicitly enabled in non-production
DEMO_PASSWORD=your_custom_secure_password_here

# Sarvam AI - Multilingual Speech-to-Text and Text-to-Speech
# Obtain your API subscription key from https://www.sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_MODEL_STT=saaras:v4
SARVAM_MODEL_TTS=bulbul:v3
